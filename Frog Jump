// Frog Jump-Dynamic Programming
import java.util.*;
 public class Main {
    public static int frogJump(int[] stones) {
        int prev=0;
        int prev2=0;
        for(int i=1;i<stones.length;i++){
            int jumpOne= prev+ Math.abs(stones[i]- stones[i-1]);
            int jumpTwo= Integer.MAX_VALUE;
            if(i>1){
                jumpTwo= prev2 + Math.abs(stones[i]-stones[i-2]);
            }
            int current= Math.min(jumpOne,jumpTwo);
            prev2=prev;
            prev=current;
        }
        return prev;
    }
    public static void main(String[] args){
        int[] stones={10,20,30,40};
        System.out.println(frogJump(stones));
    }
}
