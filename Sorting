//Selection sort,Bubble sort and Insertion sort
import java.util.*;

class Main {

    void selectionSort(int[] arr) {
        int n=arr.length;
        for(int i=0;i<=n-2;i++){
            int min=i;
            for(int j=i+1;j<=n-1;j++){
                if(arr[j]<arr[min]){
                    min=j;
                }
            }
            int temp=arr[min];
                arr[min]=arr[i];
                arr[i]=temp;
        }
        
    }
