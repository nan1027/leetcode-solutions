// Frog Jump with K distance
import java.util.*;
 public class Main {
    public static int frogJump(int n,int K,int[] stones) {
        int[] dp=new int[n];
        dp[0]=0;
        for(int i=1;i<n;i++){
            int minEnergy=Integer.MAX_VALUE;
            for(int jump=1;jump<=K;jump++){
                int previous=i-jump;
                if(previous>=0){
                    int energy=dp[previous]+Math.abs(stones[i]-stones[previous]);
                    minEnergy=Math.min(minEnergy,energy);
                }
            }
            dp[i]=minEnergy;
        }
        return dp[n-1];
    }
    public static void main(String[] args){
        int[] stones={10,20,30,40};
        int n=stones.length;
        int K=1;
        System.out.println(frogJump(n,K,stones));
    }
}
